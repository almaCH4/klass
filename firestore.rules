rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getClassData(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    // Droits de délégués calculés STRICTEMENT depuis le document de classe
    function isClassLeader(classId) {
      return isVerified() && exists(/databases/$(database)/documents/classes/$(classId)) && (
        ('delegateIds' in getClassData(classId) && request.auth.uid in getClassData(classId).delegateIds) ||
        ('deputyIds' in getClassData(classId) && request.auth.uid in getClassData(classId).deputyIds)
      );
    }

    function isTitularDelegate(classId) {
      return isVerified() && exists(/databases/$(database)/documents/classes/$(classId)) &&
        ('delegateIds' in getClassData(classId) && request.auth.uid in getClassData(classId).delegateIds);
    }

    function isClassMember(classId) {
      return isVerified() && (
        getUserData().classId == classId ||
        isClassLeader(classId)
      );
    }

    function hasValidInvitation(classId) {
      return ('joinedWithInvitationId' in getUserData()) &&
             isValidId(getUserData().joinedWithInvitationId) &&
             exists(/databases/$(database)/documents/classes/$(classId)/invitations/$(getUserData().joinedWithInvitationId)) &&
             get(/databases/$(database)/documents/classes/$(classId)/invitations/$(getUserData().joinedWithInvitationId)).data.email.lower() == request.auth.token.email.lower();
    }

    function isNotMuted(classId) {
      return !('mutedUserIds' in getClassData(classId)) ||
             !(request.auth.uid in getClassData(classId).mutedUserIds);
    }

    // 1. Validation de l'adhésion à la classe (classId)
    function isValidClassJoin(incomingData, existingData) {
      let hasNoClass = (!('classId' in incomingData)) || incomingData.classId == null;
      let isClassUnchanged = existingData != null && ('classId' in existingData) && incomingData.classId == existingData.classId;

      let isDelegateCreator = incomingData.classId != null &&
        exists(/databases/$(database)/documents/classes/$(incomingData.classId)) &&
        (request.auth.uid in get(/databases/$(database)/documents/classes/$(incomingData.classId)).data.delegateIds);

      let hasValidInvite = incomingData.classId != null &&
        ('joinedWithInvitationId' in incomingData) &&
        isValidId(incomingData.joinedWithInvitationId) &&
        exists(/databases/$(database)/documents/classes/$(incomingData.classId)/invitations/$(incomingData.joinedWithInvitationId)) &&
        get(/databases/$(database)/documents/classes/$(incomingData.classId)/invitations/$(incomingData.joinedWithInvitationId)).data.email.lower() == request.auth.token.email.lower() &&
        (
          (!('isUsed' in get(/databases/$(database)/documents/classes/$(incomingData.classId)/invitations/$(incomingData.joinedWithInvitationId)).data)) ||
          get(/databases/$(database)/documents/classes/$(incomingData.classId)/invitations/$(incomingData.joinedWithInvitationId)).data.isUsed == false ||
          get(/databases/$(database)/documents/classes/$(incomingData.classId)/invitations/$(incomingData.joinedWithInvitationId)).data.usedBy == request.auth.uid
        );

      return hasNoClass || isClassUnchanged || isDelegateCreator || hasValidInvite;
    }

    // 2. Validation du rôle (DELEGATE / DEPUTY uniquement si présent dans le document de classe)
    function isValidRoleAssignment(incomingData) {
      let role = incomingData.role;
      let classId = incomingData.classId;

      return (role == 'STUDENT') ||
        (
          classId != null &&
          exists(/databases/$(database)/documents/classes/$(classId)) &&
          (
            (role == 'DELEGATE' && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.delegateIds) ||
            (role == 'DEPUTY' && ('deputyIds' in get(/databases/$(database)/documents/classes/$(classId)).data) && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.deputyIds)
          )
        );
    }

    // Entity Validations
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['STUDENT', 'DELEGATE', 'DEPUTY'] &&
             (!('classId' in data) || data.classId == null || (data.classId is string && data.classId.size() <= 128)) &&
             (!('joinedWithInvitationId' in data) || (data.joinedWithInvitationId is string && data.joinedWithInvitationId.size() <= 128));
    }

    function isValidClass(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 80 &&
             data.schoolName is string && data.schoolName.size() <= 100 &&
             data.delegateIds is list && data.delegateIds.size() <= 10 &&
             (!('deputyIds' in data) || (data.deputyIds is list && data.deputyIds.size() <= 10)) &&
             (!('chatDescription' in data) || (data.chatDescription is string && data.chatDescription.size() <= 1000)) &&
             (!('pinnedMessageId' in data) || (data.pinnedMessageId is string && data.pinnedMessageId.size() <= 128)) &&
             (!('badWordsList' in data) || (data.badWordsList is list && data.badWordsList.size() <= 100)) &&
             (!('mutedUserIds' in data) || (data.mutedUserIds is list && data.mutedUserIds.size() <= 100));
    }

    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.classId is string && data.classId.size() <= 128 &&
             data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.text is string && data.text.size() <= 2200 &&
             data.timestampMs is number;
    }

    function isValidCourse(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.classId is string && data.classId.size() <= 128 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.dayOfWeek is number && data.dayOfWeek >= 0 && data.dayOfWeek <= 6 &&
             data.startTime is string && data.startTime.size() <= 10 &&
             data.endTime is string && data.endTime.size() <= 10;
    }

    function isValidPersonalEvent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 100 &&
             data.date is string && data.date.size() <= 20 &&
             data.startTime is string && data.startTime.size() <= 10 &&
             data.endTime is string && data.endTime.size() <= 10;
    }

    function isValidInvitation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.classId is string && data.classId.size() <= 128 &&
             data.code is string && data.code.size() <= 64 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (
               ('roleTarget' in data && data.roleTarget in ['STUDENT', 'DEPUTY']) ||
               ('targetRole' in data && data.targetRole in ['STUDENT', 'DEPUTY'])
             );
    }

    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.classId is string && data.classId.size() <= 128 &&
             data.action is string && data.action.size() <= 100 &&
             data.details is string && data.details.size() <= 500;
    }

    // 1. Users Collection
    // Règle 7 : L'e-mail des élèves n'est pas lisible par les autres élèves. Seuls l'utilisateur et les délégués peuvent lire le document.
    match /users/{userId} {
      allow get: if isVerified() && (
        request.auth.uid == userId ||
        (resource.data.classId != null && isClassLeader(resource.data.classId))
      );
      allow list: if isVerified() && isClassLeader(resource.data.classId);
      allow create: if isVerified() && request.auth.uid == userId && isValidUser(incoming()) &&
                    isValidRoleAssignment(incoming()) &&
                    isValidClassJoin(incoming(), null);
      allow update: if isVerified() && isValidUser(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().email == existing().email &&
                    isValidRoleAssignment(incoming()) &&
                    isValidClassJoin(incoming(), existing()) && (
                      request.auth.uid == userId ||
                      (existing().classId != null && isClassLeader(existing().classId))
                    );
      allow delete: if isVerified() && request.auth.uid == userId;

      // Personal Events subcollection
      match /personalEvents/{eventId} {
        allow read, write: if isVerified() && request.auth.uid == userId;
      }
    }

    // 2. Classes Collection
    // Règle 4 : Lecture d'une classe seulement pour les membres ou une personne avec invitation valide. Pas de lecture libre.
    // Règle 6 : Seuls les délégués titulaires peuvent modifier delegateIds.
    match /classes/{classId} {
      allow get: if isVerified() && (
        isClassMember(classId) ||
        hasValidInvitation(classId)
      );
      allow list: if false; // Pas de lecture libre ni listing

      allow create: if isVerified() && isValidId(classId) && isValidClass(incoming()) &&
                    request.auth.uid in incoming().delegateIds;

      allow update: if isVerified() && isValidId(classId) && isClassLeader(classId) &&
                    isValidClass(incoming()) && incoming().id == existing().id &&
                    (
                      incoming().delegateIds == existing().delegateIds ||
                      isTitularDelegate(classId)
                    );

      allow delete: if false;

      // Courses subcollection (Emploi du temps & Rattrapage)
      match /courses/{courseId} {
        allow read: if isClassMember(classId);
        allow create: if isClassLeader(classId) && isValidId(courseId) && isValidCourse(incoming()) &&
                      incoming().classId == classId;
        allow update: if isClassLeader(classId) && isValidId(courseId) && isValidCourse(incoming()) &&
                      incoming().classId == existing().classId;
        allow delete: if isClassLeader(classId);
      }

      // Invitations subcollection
      match /invitations/{invitationId} {
        // Lecture d'une invitation par son identifiant secret pour tout utilisateur connecté
        allow get: if isVerified();

        allow list: if isClassLeader(classId);

        allow create: if isClassLeader(classId) && isValidId(invitationId) && isValidInvitation(incoming()) &&
                      incoming().classId == classId;

        allow update: if isClassLeader(classId) || (
          isVerified() &&
          existing().email.lower() == request.auth.token.email.lower() &&
          (!('isUsed' in existing()) || existing().isUsed == false) &&
          incoming().isUsed == true &&
          incoming().usedBy == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isUsed', 'usedBy', 'status', 'acceptedAt'])
        );

        allow delete: if isClassLeader(classId);
      }

      // Audit Logs subcollection
      match /auditLogs/{logId} {
        allow read: if isClassMember(classId);
        allow create: if isClassLeader(classId) && isValidId(logId) && isValidAuditLog(incoming()) &&
                      incoming().classId == classId;
        allow update, delete: if false; // Audit logs are immutable
      }

      // Configuration privée de la classe (ex: lien d'abonnement iCal Pronote)
      // Strictement réservée aux délégués de la classe, jamais accessible par les élèves
      match /settings/{settingId} {
        allow read, write: if isClassLeader(classId);
      }

      // Chat Messages subcollection (Groupe de classe)
      // Règle 5 : senderName == profil. Sondages : options/questions inchangées. Réactions/signalements protégés.
      match /messages/{messageId} {
        allow read: if isClassMember(classId);

        allow create: if isClassMember(classId) && isNotMuted(classId) &&
                      isValidId(messageId) && isValidChatMessage(incoming()) &&
                      incoming().classId == classId &&
                      incoming().senderName == getUserData().name &&
                      (!('type' in incoming()) || incoming().type != 'poll' || isClassLeader(classId));

        allow update: if isClassMember(classId) && isValidId(messageId) && (
          isClassLeader(classId) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['reactions']) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['poll']) &&
            incoming().poll.question == existing().poll.question &&
            incoming().poll.isMultipleChoice == existing().poll.isMultipleChoice &&
            incoming().poll.options.size() == existing().poll.options.size()
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['reports']) &&
            (!('reports' in existing()) ||
              (incoming().reports.size() == existing().reports.size() + 1 &&
               incoming().reports[incoming().reports.size() - 1].userId == request.auth.uid)
            )
          )
        );

        allow delete: if isClassLeader(classId);
      }
    }

  }
}
